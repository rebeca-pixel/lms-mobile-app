{
  "name": "knockturn-lms-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Knockturn LMS - Android/iOS mobile app (Capacitor wrapper of the existing web app)",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "cap:sync": "npm run build && npx cap sync",
    "assets": "npx capacitor-assets generate --android",
    "android:open": "npx cap open android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "check": "tsc"
  },
  "dependencies": {
